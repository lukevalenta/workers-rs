{
    "name": "do-alarm-memory-leak",
    "main": "build/worker/shim.mjs",
    "build": {
        "command": "cargo install -q worker-build && worker-build --release"
    },
    "compatibility_date": "2025-09-23",
    "migrations": [
        {
            "new_sqlite_classes": [
                "MyDurableObject"
            ],
            "tag": "v1"
        }
    ],
    "durable_objects": {
        "bindings": [
            {
                "class_name": "MyDurableObject",
                "name": "MY_DURABLE_OBJECT"
            }
        ]
    },
    "observability": {
        "enabled": true
    }
}