{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "do-alarm-memory-leak-js",
    "main": "src/index.js",
    "compatibility_date": "2025-09-23",
    "account_id": "022362f27de5264a50ce60cb23293c9f",
    "migrations": [
        {
            "new_sqlite_classes": [
                "MyDurableObject"
            ],
            "tag": "v1"
        }
    ],
    "durable_objects": {
        "bindings": [
            {
                "class_name": "MyDurableObject",
                "name": "MY_DURABLE_OBJECT"
            }
        ]
    },
    "observability": {
        "enabled": true
    }
}